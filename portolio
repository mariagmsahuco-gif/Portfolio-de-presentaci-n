<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>María González Martínez · Biotecnóloga</title>
<meta name="description" content="Portfolio de María González Martínez, biotecnóloga especializada en control de calidad y análisis clínico.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&family=Instrument+Sans:wght@400;500;600&display=swap">
<style>
/* ============ COLORES Y FUENTES (cámbialos aquí) ============ */
:root{
  --bg:#F2F6F3;--surface:#FFFFFF;--ink:#10231F;--muted:#4F625D;--line:#D5E0DA;
  --green:#12372F;--leaf:#2F7A5F;--carot:#E8820C;--carot-ink:#8A4A00;--on-green:#F2F6F3;
  --head:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --body:'Instrument Sans','Segoe UI',system-ui,sans-serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0C1815;--surface:#13251F;--ink:#E8F0EC;--muted:#9DB2AA;--line:#24403A;
  --green:#0A1F1A;--leaf:#5BC29A;--carot:#F59A2B;--carot-ink:#F5B25E;--on-green:#E8F0EC}}
:root[data-theme="dark"]{--bg:#0C1815;--surface:#13251F;--ink:#E8F0EC;--muted:#9DB2AA;--line:#24403A;
  --green:#0A1F1A;--leaf:#5BC29A;--carot:#F59A2B;--carot-ink:#F5B25E;--on-green:#E8F0EC}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.05rem/1.65 var(--body);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--head);line-height:1.1;margin:0;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--carot);outline-offset:3px;border-radius:4px}
.wrap{width:min(1080px,100% - 2.5rem);margin-inline:auto}
section{padding:5rem 0}
h2{font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;margin-bottom:2.2rem}

/* ============ MENÚ ============ */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem}
.logo{font:800 1.15rem var(--head);text-decoration:none}
nav ul{display:flex;gap:1.4rem;list-style:none;margin:0;padding:0;overflow-x:auto;scrollbar-width:none}
nav ul::-webkit-scrollbar{display:none}
nav li a{text-decoration:none;font-size:.95rem;font-weight:500;color:var(--muted);white-space:nowrap;padding:.4rem 0;border-bottom:2px solid transparent}
nav li a:hover{color:var(--ink);border-color:var(--carot)}
@media(max-width:720px){.logo{display:none}}

/* ============ CABECERA ============ */
.hero{background:var(--green);color:var(--on-green);padding:4.5rem 0 5rem;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:3rem;align-items:center}
.hero h1{font-size:clamp(3rem,9vw,6.2rem);font-weight:800;letter-spacing:-.04em}
.role{font:600 1.25rem var(--head);margin:1.4rem 0 .6rem;color:var(--carot)}
.hero p{max-width:34rem;color:color-mix(in srgb,var(--on-green) 82%,transparent)}
.cta{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
.btn{display:inline-block;padding:.8rem 1.4rem;border-radius:999px;font-weight:600;text-decoration:none;border:2px solid var(--carot);transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.main{background:var(--carot);color:#10231F}
.btn.alt{color:var(--on-green)}

/* Placa de Petri */
.dish{position:relative;aspect-ratio:1;width:min(100%,380px);margin-inline:auto;border-radius:50%;
  border:2px solid rgba(255,255,255,.25);
  background:
    radial-gradient(circle at 36% 30%,var(--carot) 0 3.2%,transparent 3.6%),
    radial-gradient(circle at 60% 24%,#F7B34D 0 2.2%,transparent 2.6%),
    radial-gradient(circle at 70% 52%,var(--carot) 0 4%,transparent 4.4%),
    radial-gradient(circle at 44% 66%,#F7B34D 0 2.8%,transparent 3.2%),
    radial-gradient(circle at 26% 54%,var(--carot) 0 1.8%,transparent 2.2%),
    radial-gradient(circle at 58% 78%,var(--carot) 0 2.2%,transparent 2.6%),
    radial-gradient(circle at 50% 50%,rgba(91,194,154,.22) 0 62%,rgba(255,255,255,.05) 63% 100%);
  box-shadow:inset 0 0 0 14px rgba(255,255,255,.04),inset 0 0 60px rgba(0,0,0,.35)}
.dish::after{content:"MG";position:absolute;inset:auto 8% 8% auto;font:800 1rem var(--head);color:rgba(255,255,255,.55);letter-spacing:.1em}
.dish i{position:absolute;border-radius:50%;background:var(--carot);animation:grow 2.4s ease-out both}
.dish i:nth-child(1){left:36%;top:30%;width:3.2%;aspect-ratio:1;animation-delay:.2s}
.dish i:nth-child(2){left:70%;top:52%;width:4%;aspect-ratio:1;animation-delay:.6s}
.dish i:nth-child(3){left:44%;top:66%;width:2.8%;aspect-ratio:1;animation-delay:1s}
@keyframes grow{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:.9}}
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr}.dish{width:min(70%,280px);order:-1;margin:0}}

/* ============ PERFIL ============ */
.profile{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
.profile p{margin:0 0 1rem;max-width:36rem}
.facts{display:grid;gap:.9rem;margin:0;padding:0;list-style:none}
.facts li{background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--carot);border-radius:6px 14px 14px 6px;padding:1rem 1.2rem}
.facts b{display:block;font-family:var(--head);font-size:1.05rem}
.facts span{color:var(--muted);font-size:.95rem}
@media(max-width:820px){.profile{grid-template-columns:1fr;gap:2rem}}

/* ============ LÍNEA TEMPORAL (formación y experiencia) ============ */
.tl{list-style:none;margin:0;padding:0 0 0 1.8rem;border-left:2px solid var(--line)}
.tl li{position:relative;padding:0 0 2.2rem 1rem}
.tl li:last-child{padding-bottom:0}
.tl li::before{content:"";position:absolute;left:calc(-1.8rem - 7px);top:.45rem;width:12px;height:12px;border-radius:50%;background:var(--bg);border:3px solid var(--leaf)}
.tl li.now::before{background:var(--carot);border-color:var(--carot)}
.when{font:600 .9rem var(--body);color:var(--carot-ink)}
.tl h3{font-size:1.3rem;margin:.2rem 0 .1rem}
.where{color:var(--muted);font-weight:500;margin:0 0 .5rem}
.tl p{margin:0;max-width:44rem}
.alt-bg{background:var(--surface);border-block:1px solid var(--line)}

/* ============ HABILIDADES E IDIOMAS ============ */
.skill
